  <property name="styleSheet">
   <string notr="true">/* 整体背景 */
QWidget#centralwidget {
    background-color: #f8f9fa;
}

/* 标签样式（优先级/完成状态） */
QLabel#label, QLabel#label_2 {
    font-size: 12px;
    color: #343a40;
    padding: 2px 5px;
}

/* 复选框（已完成） */
QCheckBox#cxbCompleted {
    font-size: 12px;
    color: #343a40;
    padding: 2px 5px;
}

/* 下拉框（优先级） */
QComboBox#cxbPriority {
    font-size: 12px;
    padding: 3px 8px;
    border: 1px solid #ced4da;
    border-radius: 4px;
    background-color: #ffffff;
}
QComboBox#cxbPriority::drop-down {
    border-left: 1px solid #ced4da;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* 按钮通用基础样式 */
QPushButton {
    font-size: 12px;
    padding: 6px 12px;
    border: none;
    border-radius: 4px;
    color: #ffffff;
}
QPushButton:hover {
    opacity: 0.9; /*  hover时轻微透明 */
}
QPushButton:pressed {
    opacity: 0.8; /* 按下时更透明 */
}

/* 各按钮单独配色（区分功能） */
QPushButton#btnAddTask {
    background-color: #28a745; /* 绿色-添加 */
}
QPushButton#btnDeleteTask {
    background-color: #dc3545; /* 红色-删除 */
}
QPushButton#btnExport {
    background-color: #007bff; /* 蓝色-导出 */
}
QPushButton#btnFilterPriority, QPushButton#btnFilterCompleted {
    background-color: #ffc107; /* 黄色-筛选 */
}
QPushButton#btnRefresh {
    background-color: #6c757d; /* 灰色-刷新 */
}

/* 任务表格样式 */
QTableView#tableView {
    border: 1px solid #ced4da;
    border-radius: 4px;
    background-color: #ffffff;
    alternate-background-color: #f1f3f5; /* 隔行变色 */
}
QTableView#tableView::item {
    padding: 6px;
    border-bottom: 1px solid #e9ecef;
}
QTableView#tableView::item:selected {
    background-color: #e3f2fd; /* 选中行背景 */
    color: #343a40;
}</string>
  </property>
